# Copy to .env.local for local builds, or set the same vars in
# Cloudflare Pages → Settings → Environment variables (Production).
# Rebuild after changing VITE_* vars — they are baked in at build time.

# Public URL of the deployed site (no trailing slash), e.g.
#   https://piyush-priya-wedding.pages.dev
# or your custom domain. Used by the WhatsApp share button and by
# og:image / og:url so link previews resolve.
VITE_SITE_URL=

# Option A: any REST endpoint that accepts a JSON POST.
VITE_RSVP_ENDPOINT=

# Option B: Supabase (no SDK needed, plain fetch). See README for the table + policy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABLE=rsvps
